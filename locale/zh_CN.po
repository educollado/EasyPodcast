msgstr "读取 ZIP 数据时出错。"

msgid "Error al guardar un fichero importado."
msgstr "保存导入的文件时出错。"

msgid "El ZIP no contiene rutas válidas de images/ o audios/."
msgstr "ZIP 文件中没有有效的 images/ 或 audios/ 路径。"

msgid "No se pudo conectar con GitHub (HTTP %d)."
msgstr "无法连接 GitHub（HTTP %d）。"

msgid "No se pudo conectar con GitHub."
msgstr "无法连接 GitHub。"

msgid "Respuesta inesperada de GitHub."
msgstr "GitHub 返回了异常响应。"

msgid "Versión no reconocida: %s."
msgstr "无法识别版本：%s。"

msgid "No se encontró el archivo .tar.gz en la release."
msgstr "发布版本中未找到 .tar.gz 文件。"

msgid "URL de descarga no permitida."
msgstr "不允许使用此下载 URL。"

msgid "La extensión phar no está disponible en este servidor. Actualiza manualmente."
msgstr "此服务器未提供 phar 扩展。请手动更新。"


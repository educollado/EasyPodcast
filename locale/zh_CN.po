msgid "El valor de explícito no es válido."
msgstr "儿童不宜内容的设置值无效。"

msgid "El estado debe ser draft o published."
msgstr "状态必须为 draft 或 published。"

msgid "El tipo de episodio debe ser full, trailer o bonus."
msgstr "单集类型必须为 full、trailer 或 bonus。"

msgid "Título y descripción son obligatorios."
msgstr "标题和描述为必填项。"

msgid "La fecha de publicación no es válida."
msgstr "发布日期无效。"

msgid "Revisa los campos numéricos: deben ser enteros positivos."
msgstr "请检查数字字段：必须为正整数。"


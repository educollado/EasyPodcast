msgstr "请填写音频 URL 或上传音频文件。"

msgid "El MIME del audio es obligatorio."
msgstr "音频 MIME 类型为必填项。"

msgid "El tamaño del audio debe ser un entero mayor que 0."
msgstr "音频大小必须为大于 0 的整数。"

msgid "Capítulo actualizado correctamente."
msgstr "单集已更新。"


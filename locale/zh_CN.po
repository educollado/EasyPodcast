msgstr "数据库已导入，但无法重新生成 feed.xml/sitemap.xml。"

msgid "(Aviso: no se pudo borrar el backup temporal en /backups)"
msgstr "（警告：无法删除 /backups 中的临时备份）"

msgid "No se pudo validar/importar el archivo: %s"
msgstr "无法验证或导入文件：%s"

msgid "Todos los ficheros ZIP deben tener extensión .zip."
msgstr "所有 ZIP 文件的扩展名都必须为 .zip。"

msgid "No se pudo subir uno de los ZIP de ficheros."
msgstr "其中一个 ZIP 文件上传失败。"


msgstr "图片 MIME 类型无效：%s"

msgid "MIME de audio no válido: %s"
msgstr "音频 MIME 类型无效：%s"

msgid "No se pudo preparar el archivo temporal para exportar."
msgstr "无法准备导出所需的临时文件。"

msgid "No se pudo crear el archivo ZIP de exportación."
msgstr "无法创建导出 ZIP 文件。"

msgid "No hay archivos para exportar en esta parte."
msgstr "此分卷中没有可导出的文件。"

msgid "No se encontró la base de datos para exportar."
msgstr "未找到要导出的数据库。"

msgid "La extensión ZipArchive no está disponible en este servidor."
msgstr "此服务器未提供 ZipArchive 扩展。"

msgid "Tipo de exportación inválido."
msgstr "导出类型无效。"

msgid "No hay archivos para exportar en %s/."
msgstr "%s/ 中没有可导出的文件。"

msgid "No hay ficheros exportables en ZIP para %s/. Descarga manualmente los que superan 127 MB desde la lista inferior."
msgstr "%s/ 中没有可导出为 ZIP 的文件。请在下方列表中手动下载超过 127 MB 的文件。"

msgid "La parte solicitada no existe para %s."
msgstr "%s 中不存在所请求的分卷。"

msgid "Selecciona un archivo de base de datos."
msgstr "请选择数据库文件。"

msgid "No se pudo subir el archivo."
msgstr "无法上传文件。"

msgid "El archivo debe tener extensión .sqlite o .db."
msgstr "文件扩展名必须为 .sqlite 或 .db。"

msgid "La base de datos importada no parece válida para EasyPodcast."
msgstr "导入的数据库似乎不是有效的 EasyPodcast 数据库。"

msgid "La extensión SQLite3 no está disponible en este servidor."
msgstr "此服务器未提供 SQLite3 扩展。"

msgid "No se pudo crear el directorio de backups."
msgstr "无法创建备份目录。"

msgid "No se pudo crear el backup previo de seguridad."
msgstr "无法创建导入前的安全备份。"

msgid "Falló la importación de la base de datos."
msgstr "数据库导入失败。"


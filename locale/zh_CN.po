msgstr "“%s”的值不是有效的 URL。"

msgid "Redes sociales guardadas correctamente."
msgstr "社交媒体链接已保存。"

msgid "Título, descripción y enlace son obligatorios."
msgstr "标题、描述和链接为必填项。"

msgid "No se pueden seleccionar más de 3 categorías."
msgstr "最多只能选择 3 个分类。"

msgid "La cantidad de elementos del feed debe ser un entero igual o mayor que 0."
msgstr "RSS 订阅源的条目数必须为大于或等于 0 的整数。"

msgid "La cantidad de elementos de la portada debe ser un entero mayor o igual que 1."
msgstr "首页条目数必须为大于或等于 1 的整数。"

msgid "El tipo de podcast debe ser episodic o serial."
msgstr "节目类型必须为 episodic 或 serial。"

msgid "El email del propietario no es válido."
msgstr "所有者的电子邮箱无效。"

msgid "No se pudo subir la imagen del podcast."
msgstr "无法上传节目封面。"

msgid "El fichero debe ser una imagen válida (jpg, png, gif o webp)."
msgstr "文件必须为有效的图片（jpg、png、gif 或 webp）。"

msgid "No se pudo crear la carpeta de imágenes."
msgstr "无法创建图片文件夹。"

msgid "No se pudo guardar la imagen subida."
msgstr "无法保存上传的图片。"

msgid "Podcast actualizado correctamente."
msgstr "节目已更新。"

msgid "Podcast guardado correctamente."
msgstr "节目已保存。"

msgid "No se pudo generar favicon.ico (falta extension GD)."
msgstr "无法生成 favicon.ico（缺少 GD 扩展）。"

msgid "No se pudo generar favicon.ico (imagen del podcast no localizada en servidor)."
msgstr "无法生成 favicon.ico（服务器上未找到节目封面）。"

msgid "No se pudo generar favicon.ico (fallo al convertir imagen)."
msgstr "无法生成 favicon.ico（图片转换失败）。"

msgid "No se pudo escribir favicon.ico en disco."
msgstr "无法将 favicon.ico 写入磁盘。"

msgid "Aviso: %s"
msgstr "警告：%s"

msgid "Completa usuario, contraseña y confirmación."
msgstr "请填写用户名、密码和确认密码。"

msgid "Las contraseñas no coinciden."
msgstr "两次输入的密码不一致。"

msgid "La contraseña debe tener al menos 8 caracteres."
msgstr "密码至少需要 8 个字符。"

msgid "Usuario administrador creado correctamente."
msgstr "管理员账号已创建。"

msgid "Introduce usuario y contraseña."
msgstr "请输入用户名和密码。"

msgid "Credenciales inválidas."
msgstr "用户名或密码不正确。"

msgid "Introduce el código de verificación."
msgstr "请输入验证码。"

msgid "Código incorrecto. Inténtalo de nuevo."
msgstr "验证码不正确。请重试。"

msgid "Error interno al verificar el código."
msgstr "验证代码时发生内部错误。"

msgid "La URL debe usar http o https."
msgstr "URL 必须使用 http 或 https。"

msgid "Error al descargar el feed: %s"
msgstr "下载 RSS 订阅源时出错：%s"

msgid "El servidor devolvió HTTP %d."
msgstr "服务器返回 HTTP %d。"

msgid "El feed está vacío."
msgstr "RSS 订阅源为空。"

msgid "La URL del feed no es válida."
msgstr "RSS 订阅源 URL 无效。"

msgid "No se pudo parsear el XML del feed."
msgstr "无法解析 RSS 订阅源的 XML。"

msgid "El feed no contiene un elemento <channel>."
msgstr "RSS 订阅源中没有 <channel> 元素。"

msgid "URL no válida (debe ser http/https)."
msgstr "URL 无效（必须使用 http/https）。"

msgid "No se pudo crear el fichero destino."
msgstr "无法创建目标文件。"

msgid "Error cURL: %s"
msgstr "cURL 错误：%s"


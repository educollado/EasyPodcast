# Páginas de error personalizadas.
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php

<IfModule mod_rewrite.c>
RewriteEngine on
# Fuerza HTTPS en todas las rutas.
# En Docker con DISABLE_HTTPS_REDIRECT=true el entrypoint crea este fichero
# de señal; mientras exista, el redirect no se activa aunque el updater
# restaure .htaccess con los ficheros de la nueva versión.
RewriteCond %{DOCUMENT_ROOT}/docker/.disable_https_redirect !-f
RewriteCond %{HTTPS} !=on [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# Bloquea acceso directo a archivos/rutas sensibles.
RewriteRule ^(?:podcast\.sqlite|schema\.sql|AGENTS\.md)$ - [F,L,NC]
RewriteRule ^backups(?:/|$) - [F,L,NC]
RewriteRule ^tests(?:/|$) - [F,L,NC]
RewriteRule ^\.git - [F,L,NC]
# Defensa en profundidad: ningún fichero ejecutable puede servirse desde las
# carpetas de contenido controladas por subidas o importaciones.
RewriteRule ^(?:[a-z0-9-]+/)?(?:audios|images)(?:/|$).*\.(?:php(?:[0-9]+|s)?|pht(?:ml)?|phar)(?:/|$) - [F,L,NC]
# Sirve robots.txt dinámicamente para que el dominio sea siempre correcto.
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^feed\.xml$ feed.php [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^search/?$ search.php [L,QSA]
RewriteRule ^track/?$ track.php [L,QSA]
# Pasa la cabecera Authorization a PHP (Apache la elimina por defecto).
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]
# API REST: enruta /api/v1/* al router de la API.
RewriteRule ^([a-z0-9-]+)/api/v1/(.*)$ api/index.php?podcast_slug=$1 [L,QSA]
RewriteRule ^api/v1/(.*)$ api/index.php [L,QSA]

# Mantiene archivos/directorios existentes sin tocar por reglas de rewrite.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rutas públicas aisladas por podcast. Los slugs reservados se validan al guardarlos.
RewriteRule ^([a-z0-9-]+)/audios/(.+)$ audios/$1/$2 [L]
RewriteRule ^([a-z0-9-]+)/images/(.+)$ images/$1/$2 [L]
RewriteRule ^([a-z0-9-]+)/feed\.xml$ feed.php?podcast_slug=$1 [L,QSA]
RewriteRule ^([a-z0-9-]+)/sitemap\.xml$ sitemap.php?podcast_slug=$1 [L,QSA]
RewriteRule ^([a-z0-9-]+)/search/?$ search.php?podcast_slug=$1 [L,QSA]
RewriteRule ^([a-z0-9-]+)/track/?$ track.php?podcast_slug=$1 [L,QSA]
RewriteRule ^([a-z0-9-]+)/([0-9]{4})/([0-9]{2})/([a-z0-9-]+)/?$ episode.php?podcast_slug=$1&year=$2&month=$3&slug=$4 [L,QSA]
# Ruta legacy de episodio. En Multipodcast, episode.php la redirige al podcast destacado.
RewriteRule ^([0-9]{4})/([0-9]{2})/([a-z0-9-]+)/?$ episode.php?year=$1&month=$2&slug=$3 [L,QSA]
RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/([a-z0-9-]+)/?$ route.php?first=$1&second=$2&third=$3 [L,QSA]
RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/?$ route.php?first=$1&second=$2 [L,QSA]
RewriteRule ^([a-z0-9-]+)/?$ route.php?first=$1 [L,QSA]
</IfModule>
# Evita listado de directorios.
Options -Indexes
# Limite maximo de subida por peticion HTTP (128 MiB).
LimitRequestBody 134217728
# Ajustes PHP de subida cuando se usa mod_php.
<IfModule mod_php.c>
php_value upload_max_filesize 128M
php_value post_max_size 128M
php_value max_file_uploads 50
</IfModule>
# Cabeceras para Strict Transport y Permision Policy
<IfModule mod_headers.c>
Header set Strict-Transport-Security "max-age=31536000; preload" env=HTTPS
# El CSP se emite desde PHP para poder adjuntar nonces por request.
Header always set X-Content-Type-Options "nosniff"
Header always set X-XSS-Protection "1; mode=block"
Header always set Expect-CT "max-age=7776000, enforce"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(); midi=();notifications=();push=();sync-xhr=();accelerometer=(); gyroscope=(); magnetometer=(); payment=(); camera=(); microphone=();usb=(); xr=();speaker=(self);vibrate=();fullscreen=(self);"
Header always append X-Frame-Options SAMEORIGIN
</IfModule>
